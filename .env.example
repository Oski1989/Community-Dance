# ─── SUPABASE CONFIGURATION ───────────────────────────────────
# Copia este archivo como .env.local y rellena con tus valores reales.
# Proyecto URL: Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# API Key anon (public): Supabase > Project Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# API Key service_role (secret): Solo usar en servidor/admin. NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Email del primer superadmin de la plataforma
INITIAL_SUPERADMIN_EMAIL=tu_email@ejemplo.com
